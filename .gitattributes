# Keep text assets LF on disk and in the repository. GitHub Pages serves them
# byte-for-byte, so this keeps the HTML the same locally and in production.
* text=auto eol=lf

*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.xml    text eol=lf
*.txt    text eol=lf
*.md     text eol=lf
*.py     text eol=lf
*.ps1    text eol=crlf

*.webp   binary
*.jpg    binary
*.png    binary
*.gif    binary
*.pdf    binary
*.mp4    binary
*.svg    text eol=lf